{
  "name": "@isthis/agentic",
  "version": "0.2.0",
  "packageManager": "pnpm@10.15.0",
  "description": "Create shared development-guidance Profiles and safely apply and synchronize them across projects and AI agents",
  "repository": {
    "type": "git",
    "url": "https://github.com/IsthisLee/agentic.git"
  },
  "homepage": "https://github.com/IsthisLee/agentic#readme",
  "bugs": {
    "url": "https://github.com/IsthisLee/agentic/issues"
  },
  "type": "module",
  "bin": {
    "agentic": "./bin/agentic.mjs",
    "agt": "./bin/agt.mjs"
  },
  "files": [
    "bin",
    "templates",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test evals/**/*.test.mjs",
    "check:docs": "node tools/check-docs.mjs",
    "check:syntax": "node tools/check-syntax.mjs",
    "check": "pnpm run check:syntax && pnpm run check:docs && pnpm test",
    "check:release": "node tools/check-release.mjs",
    "pack:check": "npm pack --dry-run",
    "audit": "pnpm audit --audit-level high",
    "package:smoke": "node tools/package-smoke.mjs",
    "prepublishOnly": "pnpm run check && pnpm run pack:check"
  },
  "keywords": [
    "agentic",
    "agent-guidance",
    "ai-agents",
    "claude-code",
    "codex",
    "antigravity",
    "tdd",
    "agent-config",
    "gemini",
    "cursor",
    "copilot",
    "github"
  ],
  "author": "Isthis",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.0",
    "diff": "^9.0.0"
  }
}
