{
  "name": "@isthis/agentic",
  "version": "0.1.0",
  "description": "Cross-Agent Development Harness & Verification Kit (Codex, Claude Code, Antigravity, Cursor)",
  "type": "module",
  "bin": {
    "agentic": "./bin/agentic.mjs"
  },
  "files": [
    "bin",
    "templates",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "sync": "node ./bin/agentic.mjs sync",
