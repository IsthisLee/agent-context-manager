{
  "name": "agent-context-manager",
  "version": "0.4.0",
  "packageManager": "pnpm@10.15.0",
  "description": "A profile-based context manager for AI coding agents: keep rules in profiles, apply one per repository, and keep Codex, Claude Code, and Antigravity in sync",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IsthisLee/agent-context-manager.git"
  },
  "homepage": "https://github.com/IsthisLee/agent-context-manager#readme",
  "bugs": {
    "url": "https://github.com/IsthisLee/agent-context-manager/issues"
  },
  "type": "module",
  "bin": {
    "agctx": "dist/agctx.js"
  },
  "files": [
    "dist",
    "templates",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test evals/**/*.test.ts",
    "typecheck": "tsc -p tsconfig.json",
    "build": "node tools/build.ts",
    "prepack": "node tools/build.ts",
    "check:docs": "node tools/check-docs.ts",
    "check": "pnpm run typecheck && pnpm run check:docs && pnpm test",
    "check:release": "node tools/check-release.ts",
    "pack:check": "npm pack --dry-run",
    "audit": "pnpm audit --audit-level high",
    "package:smoke": "node tools/package-smoke.ts",
    "prepublishOnly": "pnpm run check && pnpm run pack:check"
  },
  "keywords": [
    "agctx",
    "agent-guidance",
    "ai-agents",
    "claude-code",
    "codex",
    "antigravity",
    "tdd",
    "agent-config",
    "gemini",
    "github"
  ],
  "author": "Isthis",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.0",
    "diff": "^9.0.0"
  },
  "devDependencies": {
    "@types/node": "22.20.2",
    "typescript": "7.0.2"
  }
}
