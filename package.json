    "check": "npm run check:docs && node ./bin/agentic.mjs check"
  },
  "keywords": [
    "agentic",
    "harness",
    "ai-agents",
    "claude-code",
    "codex",
    "antigravity",
    "tdd",
    "verification"
  ],
